<script src='https://usetrmnl.com/js/highcharts/12.3.0/highcharts.js'></script>
<script src='https://usetrmnl.com/js/chartkick/5.0.1/chartkick.min.js'></script>

{% liquid
  assign station_id = trmnl.plugin_settings.custom_fields_values.station_id
  assign current_time = 'now' | date: "%s" | plus: trmnl.user.utc_offset
  assign chart_id = 'tide-chart-' | append_random
%}

<script type='text/javascript'>
  function drawTides({small}) {
    const now = new Date()
    now.setSeconds({{ trmnl.user.utc_offset | default: 0 }})
    const labelSize = small ? '1.4em' : '2em'
  
    const heights = {{ IDX_1.predictions | json }}.map(p => [p.t, Number(p.v)])
    new Chartkick.LineChart(
      '{{ chart_id }}',
      heights,
      {
        colors: ['#000', '#FFF'],
        library: {
          plotOptions: { series: { animation: false, lineWidth: 4, color: "#000000", marker: { enabled: false } } },
          yAxis: {
            labels: {
              style: {
                fontSize: labelSize,
              },
            },
          },
          xAxis: {
            type: 'datetime',
            labels: {
              format: '{value:%l%p}',
              style: {
                fontSize: labelSize,
              },
            },
            plotLines: [{
                width: 2,
                color: '#000',
                value: now.getTime(),
            }],
          }
        },
      },
    )
  }
</script>

{% template tide_time %}
  {% liquid
    assign bits = hilo.t | split: ' '
    assign time = bits[1]
    assign time_bits = time | split: ':'
    assign hours = time_bits[0] | abs
    if hours > 11
      assign ampm = 'p'
    else
      assign ampm = 'a'
    endif
    if hours > 12
      assign hours = hours | minus: 12
    endif
    assign minutes = time_bits[1]
    assign tide = hilo.type | append: ' ' | append: hours | append: ':' | append: minutes | append: ampm
  %}
  {{ tide }}
{% endtemplate %}

{% template daily_tide_chart %}
  {% liquid
  # --- CONTINUOUS MOON ENGINE ---
  assign now_epoch = 'now' | date: "%s"
  assign age_secs = now_epoch | minus: 947182440
  assign f = age_secs | modulo: 2551443 | divided_by: 2551443.0

  # f: 0 = new, 0.5 = full. u folds the cycle to 0..0.5
  if f < 0.5
    assign waxing = true
    assign u = f
  else
    assign waxing = false
    assign u = 1.0 | minus: f
  endif

  # d folds again to 0..0.25 (angle from nearest new/full moon)
  if u < 0.25
    assign d = u
    assign gibbous = false
  else
    assign d = 0.5 | minus: u
    assign gibbous = true
  endif

  # Bhaskara cosine approximation for x in 0..pi/2
  assign x = d | times: 6.2831853
  assign x2 = x | times: x
  assign four_x2 = x2 | times: 4
  assign num = 9.8696044 | minus: four_x2
  assign den = 9.8696044 | plus: x2
  assign c = num | divided_by: den
  assign rx = c | times: 48 | round: 1

  # Illumination %
  if gibbous
    assign cos_t = c | times: -1
  else
    assign cos_t = c
  endif
  assign illum = 1.0 | minus: cos_t | times: 50 | round

  # Arc sweeps: first arc = outer limb (right side if waxing, left if waning)
  if waxing
    assign limb = 1
    if gibbous
      assign sweep2 = 1
    else
      assign sweep2 = 0
    endif
  else
    assign limb = 0
    if gibbous
      assign sweep2 = 0
    else
      assign sweep2 = 1
    endif
  endif

  # Names
  if illum < 2
    assign phase_name = "New Moon"
  elsif illum > 98
    assign phase_name = "Full Moon"
  elsif rx < 3
    if waxing
      assign phase_name = "1st Qtr"
    else
      assign phase_name = "3rd Qtr"
    endif
  elsif gibbous
    if waxing
      assign phase_name = "Wax. Gibb."
    else
      assign phase_name = "Wan. Gibb."
    endif
  else
    if waxing
      assign phase_name = "Wax. Cres."
    else
      assign phase_name = "Wan. Cres."
    endif
  endif

  assign moon_svg = '<circle cx="50" cy="50" r="48" fill="black" /><path d="M 50 2 A 48 48 0 0 ' | append: limb | append: ' 50 98 A ' | append: rx | append: ' 48 0 0 ' | append: sweep2 | append: ' 50 2 Z" fill="white" />'
%}

  <!-- Master Multi-Column Header Layout Container -->
  <div class='flex flex--row border--h-4 pb--2 mb--2' style='justify-content: space-around; align-items: center;'>
  
    <!-- COLUMN 1: Moon Phase Data Container -->
    <div class='flex flex--col items-center justify-center mr--4'>

      <!-- Row 1: Upgraded 42px SVG Image Bounding Container -->
      <div style='width: 42px; height: 42px; min-width: 42px; margin-bottom: 4px;'>
        <svg viewBox="0 0 100 100" style="width: 42px; height: 42px; display: block; border: 1px solid black; border-radius: 50%;">
          {{ moon_svg }}
        </svg>
      </div>
      <!-- Row 2: Smaller Label Name -->
      <div class='value value--xxsmall' style='white-space: nowrap; line-height: 1;'>
        {{ phase_name }} {{ illum }}%
      </div>
    </div>

    <!-- COLUMN 2: Pure Space-Between Tide Matrix Info -->
    <div class='flex flex--col' style='flex-grow: 1;'>
      <!-- Row 1: High/Low Tide Prediction Values -->
      <div class='flex flex--row' style='width: 100%; justify-content: space-around; align-items: center; margin-bottom: 4px;'>
        {% for hilo in IDX_3.predictions %}
          <div class='value value--{{ hilo_size }}' data-value-fit='true'>
            {% render 'tide_time', hilo: hilo %}
          </div>
        {% endfor %}
      </div>
      <!-- Row 2: Heights Data String Values -->
      <div class='flex flex--row' style='width: 100%; justify-content: space-around; align-items: center;'>
        {% for hilo in IDX_3.predictions %}
          <div class='value value--xxsmall' data-value-fit='true'>
            {{ hilo.v }} ft
          </div>
        {% endfor %}
      </div>
    </div>

  </div>

  <!-- Chart Space Block Frame -->
  <div id='{{ chart_id }}' style='width: 100%; flex-grow: 1;'></div>

  <!-- Bottom Details Bar Frame -->
  <div class='title_bar text-stroke flex gap--space-between'>
    <span class='title station' data-clamp="1">Station: {{ IDX_2.stations[0].name }} ({{ station_id }})</span>
    <span class='title current-time' data-clamp="1">{{ IDX_0.data[0].t | date: "%l:%M %p" }}</span>
    <span class='title height' data-clamp="1">Level: {{ IDX_0.data[0].v }} ft above MLLW</span>
  </div>
{% endtemplate %}
